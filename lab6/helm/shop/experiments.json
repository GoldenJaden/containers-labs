{
  "uid": "shop-lab6-experiments",
  "title": "Shop / Lab 6 / Experiments",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "lab6",
    "linkerd"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "lab6",
        "current": {
          "text": "lab6",
          "value": "lab6"
        }
      },
      {
        "name": "release",
        "type": "constant",
        "query": "shop",
        "current": {
          "text": "shop",
          "value": "shop"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend and client errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(version)(rate(shop_order_requests_total{namespace=\"$namespace\",lab_release=\"$release\",status=~\"5..\"}[1m])) / sum by(version)(rate(shop_order_requests_total{namespace=\"$namespace\",lab_release=\"$release\"}[1m]))",
          "legendFormat": "backend {{version}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(shop_client_requests_total{namespace=\"$namespace\",lab_release=\"$release\",status!=\"201\"}[1m])) / sum(rate(shop_client_requests_total{namespace=\"$namespace\",lab_release=\"$release\"}[1m]))",
          "legendFormat": "client"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Canary: actual v2 share and errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbound_http_route_backend_requests_total{namespace=\"$namespace\",lab_release=\"$release\",lab_component=\"client\",parent_name=\"shop-api\",backend_name=\"shop-api-v2\"}[1m])) / sum(rate(outbound_http_route_backend_requests_total{namespace=\"$namespace\",lab_release=\"$release\",lab_component=\"client\",parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "v2 backend attempt share"
        },
        {
          "refId": "B",
          "expr": "sum(rate(shop_order_requests_total{namespace=\"$namespace\",lab_release=\"$release\",version=\"v2\",status=~\"5..\"}[1m])) / sum(rate(shop_order_requests_total{namespace=\"$namespace\",lab_release=\"$release\",version=\"v2\"}[1m]))",
          "legendFormat": "v2 backend errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Client p95 (full response)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(shop_client_duration_seconds_bucket{namespace=\"$namespace\",lab_release=\"$release\"}[3m])))",
          "legendFormat": "client p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "API and server proxy CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(container)(max by(namespace,pod,container)(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"shop-api-v1-.*\",container=~\"api|linkerd-proxy\",image!=\"\"}[3m])))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "API and server proxy memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(container)(max by(namespace,pod,container)(avg_over_time(container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"shop-api-v1-.*\",container=~\"api|linkerd-proxy\",image!=\"\"}[3m])))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Mesh backend attempts per logical request",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbound_http_route_backend_requests_total{namespace=\"$namespace\",lab_release=\"$release\",lab_component=\"client\",parent_name=\"shop-api\"}[1m])) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"$namespace\",lab_release=\"$release\",lab_component=\"client\",parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "attempts / request"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
