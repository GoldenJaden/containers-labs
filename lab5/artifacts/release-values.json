{
  "api": {
    "image": "192.168.0.242:3000/gjaden/lab4-api:1.0.1",
    "port": 8080,
    "replicas": 3,
    "resources": {
      "limits": {
        "memory": "160Mi"
      },
      "requests": {
        "cpu": "15m",
        "memory": "100Mi"
      }
    },
    "service": {
      "nodePort": 30085,
      "type": "NodePort"
    }
  },
  "database": {
    "image": "ghcr.io/cloudnative-pg/postgresql:18",
    "instances": 1,
    "name": "shop-db",
    "resources": {
      "limits": {
        "memory": "256Mi"
      },
      "requests": {
        "cpu": "20m",
        "memory": "128Mi"
      }
    },
    "storage": "2Gi",
    "storageClass": "proxmox-data-xfs"
  },
  "loadTest": {
    "enabled": false,
    "metricsPort": 9090
  },
  "monitoring": {
    "dashboard": true,
    "enabled": true,
    "interval": "15s"
  },
  "networkPolicy": {
    "allowApiDatabase": true,
    "allowWorkerDatabase": true,
    "apiLabels": {
      "app.kubernetes.io/component": "api"
    },
    "clientLabels": {
      "lab5-role": "client"
    },
    "databaseLabels": {
      "cnpg.io/cluster": "shop-db"
    },
    "databaseMetricsPort": 9187,
    "databasePort": 5432,
    "dnsComponents": [
      "api",
      "worker",
      "database",
      "client"
    ],
    "dnsLabels": {
      "k8s-app": "kube-dns"
    },
    "dnsNamespace": "kube-system",
    "dnsPort": 53,
    "enabled": true,
    "externalClientCIDRs": [
      "192.168.0.0/24"
    ],
    "kubernetesAPI": [
      {
        "cidr": "192.168.0.230/32",
        "port": 6443
      },
      {
        "cidr": "10.96.0.1/32",
        "port": 443
      }
    ],
    "kubernetesAPIEntity": "kube-apiserver",
    "monitoringNamespace": "monitoring",
    "operatorLabels": {
      "app.kubernetes.io/name": "cloudnative-pg"
    },
    "operatorNamespace": "cnpg-system",
    "operatorPort": 8000,
    "prometheusLabels": {
      "app.kubernetes.io/name": "prometheus"
    },
    "workerLabels": {
      "app.kubernetes.io/component": "worker"
    }
  },
  "worker": {
    "image": "192.168.0.242:3000/gjaden/lab4-worker:1.0.0",
    "port": 8081,
    "replicas": 2,
    "resources": {
      "limits": {
        "memory": "128Mi"
      },
      "requests": {
        "cpu": "5m",
        "memory": "64Mi"
      }
    },
    "service": {
      "type": "ClusterIP"
    }
  }
}